# PayResQ Enterprise - Production Environment Variables
# Copy these values into your Railway Dashboard (Service Variables)

# Runtime Environment
ENV=production
PORT=8000

# Database: Supabase PostgreSQL (replace [YOUR-PASSWORD] and [PROJECT-REF])
# Direct Connection or Transaction Pooler URI:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis / Queue: Upstash Redis (Get from Upstash Redis Dashboard -> Details -> Connect -> redis-cli / URI)
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-UPSTASH-HOST].upstash.io:6379

# Razorpay API Secrets (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx

# LLM Providers (Groq & OpenAI)
GROQ_API_KEY=gsk_xxxx
OPENAI_API_KEY=sk-proj-xxxx

# Security Secrets
JWT_SECRET_KEY=payresq-enterprise-super-secure-production-key-2025

# Frontend & Webhook Public URLs (fill after deploying to Vercel and Railway)
FRONTEND_URL=https://your-frontend.vercel.app
WEBHOOK_BASE_URL=https://your-backend.railway.app
